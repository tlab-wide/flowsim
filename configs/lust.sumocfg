<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo-sim.org/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="../LuSTScenario/scenario/lust.net.xml"/>
        <route-files value="../LuSTScenario/scenario/buslines.rou.xml,../LuSTScenario/scenario/DUARoutes/local.0.rou.xml,../LuSTScenario/scenario/DUARoutes/local.1.rou.xml,../LuSTScenario/scenario/DUARoutes/local.2.rou.xml,../LuSTScenario/scenario/transit.rou.xml"/>
        <additional-files value="../LuSTScenario/scenario/vtypes.add.xml,../LuSTScenario/scenario/busstops.add.xml,../LuSTScenario/scenario/e1detectors.add.xml,../LuSTScenario/scenario/lust.poly.xml,../LuSTScenario/scenario/tll.static.xml"/>
    </input>

    <time>
        <begin value="24000"/>
        <step-length value="1"/>
        <end value="25000"/>
    </time>

    <processing>
        <ignore-junction-blocker value="20"/>
        <time-to-teleport value="600"/>
        <max-depart-delay value="600"/>
        <routing-algorithm value="dijkstra"/>
    </processing>

    <routing>
        <device.rerouting.probability value="0.70"/>
        <device.rerouting.period value="300"/>
        <device.rerouting.pre-period value="300"/>
    </routing>

    <report>
        <verbose value="true"/>
        <log value="dua.static.log"/>
    </report>

</configuration>
